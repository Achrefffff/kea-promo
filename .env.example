# ============================================================================
#  Shopify Promo Switcher — Configuration
#  Copiez ce fichier en ".env" puis personnalisez vos valeurs.
# ============================================================================

# --- Shopify (Client Credentials Grant) --------------------------------------
# Domaine technique de la boutique (ex: ma-boutique.myshopify.com)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Identifiants de l'application (Dev Dashboard Shopify ou Partners)
SHOPIFY_CLIENT_ID=your_client_id
SHOPIFY_CLIENT_SECRET=your_client_secret

# Version de l'API GraphQL Admin Shopify (recommandé: 2026-01)
SHOPIFY_API_VERSION=2026-01

# Nombre de produits mis à jour en parallèle (1 à 5). 2 = recommandé.
SHOPIFY_CONCURRENCY=2

# Ne jamais augmenter un prix déjà soldé plus bas que la nouvelle remise.
# true = si un article est déjà à -50%, une promo à -20% ne va pas remonter son prix.
NEVER_INCREASE_PRICE=true

# --- Mode Simulation / Test (Dry-Run) ----------------------------------------
# true  = Lit le vrai catalogue Shopify et calcule les prix sans JAMAIS modifier la boutique.
# false = Permet les modifications de prix réelles (avec confirmation dans l'UI).
DRY_RUN=true

# --- Authentification (Email + Code Secret Personnel) -----------------------
# Liste blanche des utilisateurs autorisés sous la forme email:codeSecret séparés par des virgules.
# Exemple : marketing@domaine.com:CodeSecret123,patron@domaine.com:CodeBoss456
AUTHORIZED_USERS=marketing@domaine.com:CodeSecret123,patron@domaine.com:CodeBoss456,achraf@domaine.com:MonCode789

# --- Sessions ----------------------------------------------------------------
# Secret de signature des cookies de session (64+ caractères aléatoires recommandés).
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret-string-at-least-32-chars

# Cookie "Secure" : auto (recommandé, actif si HTTPS), true ou false.
COOKIE_SECURE=auto

# --- Base de données Neon PostgreSQL (Optionnel pour Vercel / Cloud) -------
# Si renseigné, l'application stocke les sauvegardes, états et logs dans Neon.
# Si vide ou absent, l'application utilise le dossier local ./data (par défaut).
# Exemple Neon : postgresql://user:password@ep-cool-frog-123.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Serveur -----------------------------------------------------------------
PORT=3000
